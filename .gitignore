# Environment files (IMPORTANT!)
# Root-anchored: protect root-level credential files
/.env
/.env.prod
# Glob patterns: protect Service_Env_Files in all subdirectories
**/.env
**/.env.local
**/.env.production
**/.env.prod
# Wildcard catch-all (must come before negation rules)
.env.*
# Negation rules (MUST appear after all wildcard rules above)
!.env.example
!**/.env.example

