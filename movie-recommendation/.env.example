# movie-recommendation service — environment variables
# Copy this file to .env for local development (outside Docker).
# In Docker Compose, these variables are injected automatically from the root .env.
# Do NOT commit .env — only this .env.example file is tracked by git.

# === DATABASE ===
# PostgreSQL connection string (full DSN format: postgresql://user:pass@host:port/db)
# Note: this service uses DATABASE_URL (not DB_URL) — must be a full postgresql:// URI
DATABASE_URL=<YOUR_VALUE_HERE>

# === ELASTICSEARCH ===
# Elasticsearch host (Docker-internal: http://elasticsearch:9200 | Production: https://<cluster>.bonsaisearch.net:443)
ES_HOST=<YOUR_VALUE_HERE>

# Full Elasticsearch URL — used for connections that require auth in production
# Format: http://elasticsearch:9200 (local) or https://user:pass@<cluster>.bonsaisearch.net (prod)
ES_URL=<YOUR_VALUE_HERE>

# === API KEYS ===
# Hugging Face API token — used to download embedding models (format: hf_...)
HF_TOKEN=<YOUR_VALUE_HERE>

# === INTER-SERVICE URLS ===
# URL of the movie-chatbot service (Docker-internal: http://movie-chatbot:8001)
CHATBOT_URL=<YOUR_VALUE_HERE>

# URL of the movie-backend service (Docker-internal: http://movie-backend:8080)
BACKEND_URL=<YOUR_VALUE_HERE>
