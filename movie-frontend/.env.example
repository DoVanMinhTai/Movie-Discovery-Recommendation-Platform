# movie-frontend environment variables
# Copy this file to .env and fill in the values for local development.
# For production (Vercel), set these as environment variables in the Vercel dashboard.

# ============================================================
# BUILD-TIME VARIABLES (injected at `npm run build` / `vite build`)
# These are NOT runtime variables — they are baked into the
# JavaScript bundle at build time by Vite's define plugin.
# They are NOT available via process.env at runtime; use
# `import.meta.env.VITE_API_BASE_URL` in source code instead.
# ============================================================

# Base URL of the movie-backend REST API.
# Local dev (Docker): http://localhost:8080
# Production (Render): https://<your-backend-service>.onrender.com
VITE_API_BASE_URL=your_vite_api_base_url_here
