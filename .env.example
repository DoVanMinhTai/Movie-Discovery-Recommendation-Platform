# =============================================================================
# ROOT .env.example — Media Recommender System
# =============================================================================
# Copy this file to .env and fill in the values for your local environment.
# NEVER commit the real .env file — only this .env.example should be tracked.
#
# Usage:
#   cp .env.example .env
#   # Then edit .env with your actual values
# =============================================================================


# === DATABASE ===

# PostgreSQL username; must match the POSTGRES_USER set in the postgres container
DB_USER=your_db_user_here

# PostgreSQL password; must match the POSTGRES_PASSWORD set in the postgres container
DB_PASSWORD=your_db_password_here

# PostgreSQL database name; must match the POSTGRES_DB set in the postgres container
DB_NAME=your_db_name_here

# PostgreSQL port exposed on the host; default is 5432
DB_PORT=your_db_port_here

# JDBC connection string for Spring Boot (movie-backend); format: jdbc:postgresql://<host>:<port>/<db>
DB_URL=your_db_url_here

# PostgreSQL connection string for Python services (movie-recommendation, initializer, mage);
# format: postgresql://<user>:<password>@<host>:<port>/<db>
DB_URL_PYTHON=your_db_url_python_here


# === ELASTICSEARCH ===

# Elasticsearch hostname (no scheme, no port) used by services as a hostname reference;
# for local Docker Compose use the service name: elasticsearch
ES_HOST=your_es_host_here

# Port for Elasticsearch HTTP API, exposed on the host; default is 9200
ES_PORT_9200=your_es_port_9200_here

# Port for Elasticsearch transport layer, exposed on the host; default is 9300
ES_PORT_9300=your_es_port_9300_here

# Elasticsearch username; leave empty if security is disabled (local dev)
ES_USERNAME=your_es_username_here

# Elasticsearch password; leave empty if security is disabled (local dev)
ES_PASSWORD=your_es_password_here

# Full Elasticsearch URL used by services for HTTP requests;
# local dev format: http://elasticsearch:9200
# production format: https://<user>:<pass>@<host>
ES_URL=your_es_url_here


# === SERVICE PORTS ===

# Host port mapped to the movie-backend Spring Boot container (internal port 8080)
BACKEND_PORT=your_backend_port_here

# Host port mapped to the movie-chatbot FastAPI container (internal port 8001)
CHATBOT_PORT=your_chatbot_port_here

# Host port mapped to the movie-recommendation FastAPI container (internal port 8002)
RECOMMENDATION_PORT=your_recommendation_port_here

# Host port mapped to the movie-frontend Nginx container (internal port 80)
FRONTEND_PORT=your_frontend_port_here


# === INTER-SERVICE URLS ===

# Internal Docker network URL for the movie-chatbot service;
# local dev format: http://movie-chatbot:8001
CHATBOT_URL=your_chatbot_url_here

# Internal Docker network URL for the movie-recommendation service;
# local dev format: http://movie-recommendation:8002
RECO_URL=your_reco_url_here

# Internal Docker network URL for the movie-backend service;
# local dev format: http://movie-backend:8080
BACKEND_URL=your_backend_url_here


# === API KEYS ===

# TMDB (The Movie Database) API key for fetching movie metadata;
# obtain at https://www.themoviedb.org/settings/api
TMDB_API_KEY=your_tmdb_api_key_here

# Hugging Face access token for downloading models and accessing HF Spaces;
# obtain at https://huggingface.co/settings/tokens
HF_TOKEN=your_hf_token_here

# Groq API key for the LLM used in movie-chatbot;
# obtain at https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here

# Groq model name to use for chat completions; example: llama3-70b-8192
GROQ_MODEL=your_groq_model_here

# Groq project ID (optional); used for billing/analytics separation
GROQ_PROJECT_ID=your_groq_project_id_here


# === CORS ===

# Comma-separated list of allowed origins for the Spring Boot CORS policy;
# include all frontend origins that should be permitted to call the API
APP_CORS_ALLOWED_ORIGINS=your_app_cors_allowed_origins_here


# === FRONTEND ===

# Base URL of the backend API consumed by the Vite frontend at build time;
# this is a BUILD-TIME variable injected via Docker Compose build.args or Vercel dashboard,
# NOT a runtime variable — format: http://<host>:<port>
VITE_API_BASE_URL=your_vite_api_base_url_here


# === MEMORY LIMITS ===

# Docker memory limit for the postgres container; format: <number><unit> (e.g., 512m, 1g)
MEM_LIMIT_POSTGRES=your_mem_limit_postgres_here

# Docker memory limit for the initializer container; format: <number><unit> (e.g., 1g)
MEM_LIMIT_INITIALIZER=your_mem_limit_initializer_here

# Docker memory limit for the elasticsearch container; format: <number><unit> (e.g., 2g)
MEM_LIMIT_ES=your_mem_limit_es_here

# Docker memory limit for API containers (movie-backend, movie-recommendation);
# format: <number><unit> (e.g., 512m)
MEM_LIMIT_API=your_mem_limit_api_here

# Docker memory limit for general service containers (movie-chatbot);
# format: <number><unit> (e.g., 512m)
MEM_LIMIT=your_mem_limit_here

# Docker memory limit for the movie-frontend container; format: <number><unit> (e.g., 256m)
MEM_LIMIT_FRONTEND=your_mem_limit_frontend_here


# === JAVA ===

# JVM tuning options passed to the Spring Boot container via JAVA_OPTS;
# format: -Xmx<max_heap> -Xms<initial_heap> [additional flags]
# example: -Xmx350m -Xms256m -XX:+UseSerialGC
JAVA_OPTS=your_java_opts_here
