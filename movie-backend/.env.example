# ==============================================================================
# movie-backend environment variables
# Copy this file to .env and fill in the actual values.
# This file is committed to git — do NOT put real credentials here.
# ==============================================================================

# --- Database (PostgreSQL) ---
# JDBC connection URL, e.g. jdbc:postgresql://<host>:<port>/<db_name>
DB_URL=<YOUR_VALUE_HERE>

# PostgreSQL username
DB_USER=<YOUR_VALUE_HERE>

# PostgreSQL password
DB_PASSWORD=<YOUR_VALUE_HERE>

# --- Elasticsearch ---
# Elasticsearch base URL, e.g. http://elasticsearch:9200 (Docker) or https://<cluster>.bonsaisearch.net
ES_URL=<YOUR_VALUE_HERE>

# Elasticsearch hostname (without scheme/port), e.g. elasticsearch (Docker) or <cluster>.bonsaisearch.net:443
ES_HOST=<YOUR_VALUE_HERE>

# --- Inter-service URLs ---
# Internal URL of the movie-chatbot service, e.g. http://movie-chatbot:8001
CHATBOT_URL=<YOUR_VALUE_HERE>

# Internal URL of the movie-recommendation service, e.g. http://movie-recommendation:8002
RECO_URL=<YOUR_VALUE_HERE>

# --- CORS ---
# Comma-separated list of allowed origins for CORS, e.g. http://localhost:5173,https://your-frontend.vercel.app
APP_CORS_ALLOWED_ORIGINS=<YOUR_VALUE_HERE>

# --- JVM tuning ---
# JVM flags for the Spring Boot process, e.g. -Xmx350m -Xms256m -XX:+UseSerialGC
JAVA_OPTS=<YOUR_VALUE_HERE>
