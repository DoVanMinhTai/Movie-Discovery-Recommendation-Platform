# movie-chatbot service environment variables
# Copy this file to .env and fill in your actual values.
# In Docker Compose, these are injected via the root .env — do NOT use this file at runtime.

ES_HOST=<YOUR_VALUE_HERE>        # Elasticsearch host URL (e.g. http://elasticsearch:9200 for local, or https://<cluster>.bonsaisearch.net for prod)
ES_URL=<YOUR_VALUE_HERE>         # Full Elasticsearch URL, may include credentials (e.g. https://user:pass@host:port)
GROQ_API_KEY=<YOUR_VALUE_HERE>   # Groq API key — starts with gsk_ (obtain from console.groq.com)
GROQ_MODEL=<YOUR_VALUE_HERE>     # Groq model name (e.g. llama3-70b-8192)
HF_TOKEN=<YOUR_VALUE_HERE>       # Hugging Face access token — starts with hf_ (obtain from huggingface.co/settings/tokens)
CHATBOT_PORT=<YOUR_VALUE_HERE>   # Port the chatbot service listens on (e.g. 8001)
